# cp this file to fleet.env, fill in your values, then:
#   set -a; source fleet.env; set +a; ./run_fleet_batch.sh
#
# --- outbound proxy (required) ---
# Browser sessions for dash.cloudflare.com MUST go through a clean residential
# egress. Each registration uses its own session; rotation of exit IPs is
# strongly recommended to avoid rate limiting / fingerprint correlation.
# Format: socks5://host:port  (or socks5h:// / http://)
PROXY=socks5://127.0.0.1:1080

# --- Inbucket catch-all mailboxes (required) ---
# Run an Inbucket instance (https://inbucket.org) that accepts mail for
# CF_EMAIL_HOST and exposes its REST API at INBUCKET_API_BASE.
# Mailbox key is the local-part only (e.g. "cf0001" for cf0001@...).
INBUCKET_API_BASE=https://mail.example.com
INBUCKET_USER=inbucket
INBUCKET_PASSWORD=change-me
CF_EMAIL_HOST=inbox.example.com

# --- batch range ---
CF_EMAIL_FROM=1
CF_EMAIL_TO=10
# CF_SKIP_HOSTS=example.net

# --- browser ---
CLOAKBROWSER_BINARY_PATH=$HOME/.cloakbrowser/latest/chrome
CLOAK_HEADLESS=0
# TURNSTILE_PATCH=/path/to/optional/extension
# OTP_TIMEOUT=120
# CF_REG_TIMEOUT=900
# CF_SHOT=0

# --- output ---
CF_BATCH_DIR=./cf-batch
CF_DOMAINS_FILE=./domains.example.json
